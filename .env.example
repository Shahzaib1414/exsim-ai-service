# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/ExsimDb

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_GPT4O=<your-gpt4o-deployment-name>
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=<your-embedding-deployment-name>

# Langfuse (LLM observability — cloud)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Azure Application Insights (APM)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=...
