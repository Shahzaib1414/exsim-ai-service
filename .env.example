# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DOTNET_API_URL=http://localhost:5001
SWAGGER_ENABLED=true

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/ExsimDb

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_EMBEDDING_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_GPT4O=<your-gpt4o-deployment-name>
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=<your-embedding-deployment-name>
AZURE_OPENAI_RESOURCE=ask_for_openai_resource
AZURE_OPENAI_EMBEDDING_ENDPOINT=ask_for_embedding_endpoint
AZURE_OPENAI_EMBEDDING_RESOURCE=ask_for_embedding_resource

# Langfuse (LLM observability — cloud)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Azure Application Insights (APM)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=...

# Smpt
SMTP_HOST=ask_for_host
SMTP_PORT=ask_for_port
SMTP_FROM=ask_for_from
SMTP_USERNAME=ask_for_username
SMTP_PASSWORD=ask_for_password

# BullMq
QUEUE_DASHBOARD_USERNAME=admin
QUEUE_DASHBOARD_PASSWORD=password